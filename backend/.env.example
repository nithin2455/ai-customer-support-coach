# Server Environment Configuration
PROJECT_NAME="AI Customer Support Coaching System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-dev-key-change-in-production"

# Database Configuration (PostgreSQL default with SQLite fallback for local testing)
# Example PostgreSQL: postgresql://user:password@localhost:5432/support_coach_db
DATABASE_URL="sqlite:///./support_coach.db"

# LLM API Configuration (Google Gemini API)
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.5-flash"

# Hugging Face Settings
USE_HF_LOCAL_MODELS=False # Set to True to load Hugging Face models locally via transformers library

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
